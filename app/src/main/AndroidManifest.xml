<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CoffeShop"
        android:usesCleartextTraffic="true">

        <!-- LOGIN: Pantalla principal -->
        <activity
            android:name=".Vista.Inicio"
            android:name=".Vista.login"
            android:exported="true"
            android:windowSoftInputMode="stateHidden|adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Crear cuenta -->
        <activity
            android:name=".Vista.crear_cuenta"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Recuperar contraseña -->
        <activity
            android:name=".Vista.recuperar_contrasena"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Favoritos -->
        <activity
            android:name=".Vista.FavoritosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Ubicación -->
        <activity
            android:name=".Vista.UbicacionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MainActivity -->
        <activity
            android:name=".Vista.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Perfil -->
        <activity
            android:name=".Vista.PerfilActivity"
            android:exported="false" />

        <!-- Inicio -->
        <activity
            android:name=".Inicio"
            android:exported="false" />

        <!-- Menú -->
        <activity
            android:name=".Vista.MenuActivity"
            android:exported="false" />

        <!-- Pedidos -->
        <activity
            android:name=".Vista.PedidosActivity"
            android:exported="false" />

        <!-- Ayuda -->
        <activity
            android:name=".Vista.AyudaActivity"
            android:exported="false" />

        <!-- Notificaciones -->
        <activity
            android:name=".Vista.notificacion"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>