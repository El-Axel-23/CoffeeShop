<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDECDC"
    tools:context=".Vista.recuperar_contrasena">

    <!-- ENCABEZADO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorEncabezado"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        app:layout_constraintWidth_max="384dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- REGRESAR -->
        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_flecha_atras"
            android:padding="12dp"
            android:contentDescription="@string/reg_volver"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- LOGO -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_coffee"
            android:contentDescription="@string/logo_coffee"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- PANTALLA 1: RECUPERAR CONTRASEÑA -->
    <ScrollView
        android:id="@+id/pantallaRecuperar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintWidth_max="384dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorEncabezado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <!-- ICONO CANDADO -->
            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_circulo_recuperar"
                android:src="@drawable/ic_candado"
                android:padding="23dp"
                android:contentDescription="@string/rec_icono_candado"/>

            <!-- TITULO -->
            <TextView
                android:id="@+id/txtTituloRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/rec_titulo"
                android:textColor="#422018"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <!-- DESCRIPCION -->
            <TextView
                android:id="@+id/txtDescripcionRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="@string/rec_descripcion"
                android:textColor="#422018"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <!-- CAMPO CORREO -->
            <LinearLayout
                android:id="@+id/contenedorCorreo"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_campo"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/txtCorreoRecuperar"
                    android:text="@string/correo"
                    android:textColor="#422018"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/txtCorreoRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="@string/hint_correo"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- MENSAJE DE ERROR -->
            <TextView
                android:id="@+id/txtErrorCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/rec_error_correo"
                android:textColor="#B93826"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="gone"/>

            <!-- ENVIAR ENLACE -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnviarEnlace"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_boton"
                android:backgroundTint="#422018"
                app:backgroundTint="#422018"
                android:text="@string/rec_enviar_enlace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp"/>

            <!-- ESPACIO PARA EL ENLACE INFERIOR -->
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- VOLVER AL LOGIN -->
            <TextView
                android:id="@+id/txtVolverLogin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:text="@string/rec_volver_login"
                android:textColor="#422018"
                android:textSize="14sp"
                android:textStyle="bold"

                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </ScrollView>

    <!-- PANTALLA 2: CORREO ENVIADO -->
    <ScrollView
        android:id="@+id/pantallaCorreoEnviado"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone"
        app:layout_constraintWidth_max="384dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorEncabezado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

            <!-- ICONO CORREO -->
            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_circulo_recuperar"
                android:src="@drawable/ic_sobre"
                android:padding="23dp"
                android:contentDescription="@string/rec_icono_correo"/>

            <!-- TITULO -->
            <TextView
                android:id="@+id/txtTituloEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/rec_correo_enviado"
                android:textColor="#422018"
                android:textSize="21sp"
                android:textStyle="bold"/>

            <!-- DESCRIPCION -->
            <TextView
                android:id="@+id/txtDescripcionEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="@string/rec_descripcion_enviado"
                android:textColor="#422018"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <!-- VOLVER A INICIAR SESION -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolverIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_boton"
                android:backgroundTint="#422018"
                app:backgroundTint="#422018"
                android:text="@string/rec_boton_volver"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp"/>

            <!-- REENVIAR CORREO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rec_no_llego"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtReenviarCorreo"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:text="@string/rec_reenviar"
                    android:textColor="#422018"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
