<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDECDC"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants"
    tools:context=".Vista.recuperar_contrasena">

    <!-- Encabezado -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contenedorEncabezado"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Regresar -->
        <ImageButton
            android:id="@+id/btnRegresar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_flecha_atras"
            android:scaleType="fitCenter"
            android:padding="12dp"
            android:contentDescription="@string/reg_volver"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Logo -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_coffee"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logo_coffee"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Pantalla recuperar contraseña -->
    <ScrollView
        android:id="@+id/pantallaRecuperar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorEncabezado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Icono de candado -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circulo_recuperar"
                android:src="@drawable/ic_candado"
                android:scaleType="fitCenter"
                android:padding="24dp"
                android:contentDescription="@string/rec_icono_candado"/>

            <!-- Título -->
            <TextView
                android:id="@+id/txtTituloRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/rec_titulo"
                android:textColor="#422018"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <!-- Descripción -->
            <TextView
                android:id="@+id/txtDescripcionRecuperar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/rec_descripcion"
                android:textColor="#422018"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <!-- Correo electrónico -->
            <LinearLayout
                android:id="@+id/contenedorCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_campo"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/txtCorreoRecuperar"
                    android:includeFontPadding="false"
                    android:text="@string/correo"
                    android:textColor="#422018"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/txtCorreoRecuperar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:background="@null"
                    android:gravity="center_vertical"
                    android:hint="@string/hint_correo"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- Mensaje de error -->
            <TextView
                android:id="@+id/txtErrorCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:text="@string/rec_error_correo"
                android:textColor="#B93826"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="gone"/>

            <!-- Enviar enlace -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnviarEnlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_boton"
                android:backgroundTint="#422018"
                app:backgroundTint="#422018"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/rec_enviar_enlace"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

            <!-- Mantener el enlace en la parte inferior -->
            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- Volver a iniciar sesión -->
            <TextView
                android:id="@+id/txtVolverLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/rec_volver_login"
                android:textColor="#422018"
                android:textSize="14sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </ScrollView>

    <!-- Pantalla correo enviado -->
    <ScrollView
        android:id="@+id/pantallaCorreoEnviado"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:visibility="gone"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintTop_toBottomOf="@id/contenedorEncabezado"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="top|center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Icono de correo -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_circulo_recuperar"
                android:src="@drawable/ic_sobre"
                android:scaleType="fitCenter"
                android:padding="24dp"
                android:contentDescription="@string/rec_icono_correo"/>

            <!-- Título -->
            <TextView
                android:id="@+id/txtTituloEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/rec_correo_enviado"
                android:textColor="#422018"
                android:textSize="22sp"
                android:textStyle="bold"/>

            <!-- Descripción -->
            <TextView
                android:id="@+id/txtDescripcionEnviado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/rec_descripcion_enviado"
                android:textColor="#422018"
                android:textSize="14sp"
                android:lineSpacingExtra="3dp"/>

            <!-- Volver a iniciar sesión -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVolverIniciarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_boton"
                android:backgroundTint="#422018"
                app:backgroundTint="#422018"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/rec_boton_volver"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:elevation="0dp"
                android:stateListAnimator="@null"/>

            <!-- Reenviar correo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:text="@string/rec_no_llego"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtReenviarCorreo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="48dp"
                    android:layout_marginStart="6dp"
                    android:gravity="start|center_vertical"
                    android:text="@string/rec_reenviar"
                    android:textColor="#422018"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>