<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6EC">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="17dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- INDICADOR -->

        <View
            android:layout_width="60dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#EBD8C3"/>

        <!-- TITULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="¿Cómo quieres pagar?"
            android:textColor="#3B1F14"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Elige una opción para tu pedido"
            android:textColor="#3B1F14"
            android:textSize="14sp"/>

        <!-- OPCIONES -->

        <RadioGroup
            android:id="@+id/rgTipoEntrega"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical">

            <!-- RECOGER EN CAFETERIA -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCafeteria"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="#F7E9DA"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#EBD8C3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_store"
                        app:tint="#3B1F14"
                        android:contentDescription="Cafetería"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pagar en la cafetería"
                            android:textColor="#3B1F14"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Efectivo al recoger tu pedido"
                            android:textColor="#3B1F14"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rbCafeteria"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:buttonTint="#3B1F14"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ENTREGA A DOMICILIO -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDomicilio"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                app:cardBackgroundColor="#F7E9DA"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="#3B1F14"
                app:strokeWidth="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/ic_delivery"
                        app:tint="#3B1F14"
                        android:contentDescription="Entrega a domicilio"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entrega a domicilio"
                            android:textColor="#3B1F14"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="Efectivo al recibir tu pedido"
                            android:textColor="#3B1F14"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <RadioButton
                        android:id="@+id/rbDomicilio"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:checked="true"
                        android:buttonTint="#3B1F14"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RadioGroup>

        <!-- DIRECCION -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDireccion"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#F7E9DA"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EBD8C3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dirección de entrega"
                    android:textColor="#3B1F14"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Escribe tu dirección"
                    android:inputType="textPostalAddress"
                    android:singleLine="true"
                    android:textColor="#3B1F14"
                    android:textColorHint="#4A2E22"
                    android:textSize="14sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- REFERENCIAS -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReferencias"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#F7E9DA"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#EBD8C3"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Referencias (opcional)"
                    android:textColor="#3B1F14"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/etReferencias"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Piso, local o indicaciones"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="#3B1F14"
                    android:textColorHint="#4A2E22"
                    android:textSize="14sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- TOTAL -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total a pagar:"
                android:textColor="#3B1F14"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvTotalPago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$103"
                android:textColor="#3B1F14"
                android:textSize="19sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- CONFIRMAR -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarPedido"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginTop="28dp"
            android:text="CONFIRMAR PEDIDO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#3B1F14"
            app:cornerRadius="20dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>