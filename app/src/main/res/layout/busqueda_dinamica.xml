<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8F6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Barra Superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/ivVolver"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Regresar"
                android:src="@drawable/ic_back"
                app:tint="#2C221E" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_buscador_inicio"
                android:backgroundTint="#F5E5D5"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Buscar"
                    android:src="@drawable/ic_search"
                    app:tint="#5E4337" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="#2C221E"
                    android:textColorHint="#8A817C"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnClear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Limpiar"
                    android:src="@drawable/ic_close"
                    app:tint="#5E4337" />
            </LinearLayout>
        </LinearLayout>

        <!-- Búsquedas recientes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Búsquedas recientes"
            android:textColor="#2C221E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvRecent1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:text="Leche"
            android:textColor="#3E3632"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_reloj"
            app:drawableTint="#6E5346" />

        <TextView
            android:id="@+id/tvRecent2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:text="Matcha"
            android:textColor="#3E3632"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_reloj"
            app:drawableTint="#6E5346" />

        <TextView
            android:id="@+id/tvRecent3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingVertical="6dp"
            android:text="Chai"
            android:textColor="#3E3632"
            android:textSize="15sp"
            app:drawableStartCompat="@drawable/ic_reloj"
            app:drawableTint="#6E5346" />

        <!-- Populares -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Populares"
            android:textColor="#2C221E"
            android:textSize="15sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPop1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_inicio_activo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Cappuccino"
                    android:textColor="#FFFDF9"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipPop2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_inicio_inactivo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Latte"
                    android:textColor="#5E4337" />

                <TextView
                    android:id="@+id/chipPop3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_chip_inicio_inactivo"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="Croissant"
                    android:textColor="#5E4337" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Resultados de búsqueda -->
        <TextView
            android:id="@+id/tvResultados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="#2C221E"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />


    </LinearLayout>
</ScrollView>