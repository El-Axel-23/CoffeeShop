<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDECDC"
    tools:context=".Vista.crear_cuenta">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintWidth_max="384dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="15dp"
            android:paddingBottom="16dp">

            <!-- ENCABEZADO -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="48dp">

                <!-- REGRESAR -->
                <ImageButton
                    android:id="@+id/btnRegresar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_flecha_atras"
                    android:padding="12dp"
                    android:contentDescription="@string/reg_volver"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!-- TITULO -->
                <TextView
                    android:id="@+id/txtTituloRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_titulo"
                    android:textColor="#422018"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <!-- LOGO -->
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_coffee"
                    android:contentDescription="@string/logo_coffee"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- SUBTITULO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/reg_subtitulo"
                android:textColor="#422018"
                android:textSize="15sp"/>

            <!-- NOMBRE COMPLETO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_campo"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:labelFor="@id/txtNombreCompleto"
                    android:text="@string/reg_nombre"
                    android:textColor="#422018"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/txtNombreCompleto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="@string/reg_hint_nombre"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- CORREO ELECTRONICO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campo"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:labelFor="@id/txtCorreoRegistro"
                    android:text="@string/correo"
                    android:textColor="#422018"
                    android:textSize="12sp"/>

                <EditText
                    android:id="@+id/txtCorreoRegistro"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="@string/hint_correo"
                    android:inputType="textEmailAddress"
                    android:autofillHints="emailAddress"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"/>

            </LinearLayout>

            <!-- CONTRASEÑA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/lblContrasenaRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:labelFor="@id/txtContrasenaRegistro"
                    android:text="@string/contrasena"
                    android:textColor="#422018"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <EditText
                    android:id="@+id/txtContrasenaRegistro"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="@string/hint_contrasena"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnVerContrasenaRegistro"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <ImageButton
                    android:id="@+id/btnVerContrasenaRegistro"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ojo_cerrado"
                    android:padding="12dp"
                    android:contentDescription="@string/mostrar_contrasena"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- REQUISITO CONTRASEÑA -->
            <TextView
                android:id="@+id/txtMinimoCaracteres"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/reg_minimo"
                android:textColor="#422018"
                android:textSize="12sp"/>

            <!-- CONFIRMAR CONTRASEÑA -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_campo"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <TextView
                    android:id="@+id/lblConfirmarContrasena"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:labelFor="@id/txtConfirmarContrasena"
                    android:text="@string/reg_confirmar"
                    android:textColor="#422018"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <EditText
                    android:id="@+id/txtConfirmarContrasena"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:hint="@string/hint_contrasena"
                    android:inputType="textPassword"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:padding="0dp"
                    android:textColor="#422018"
                    android:textColorHint="#68483A"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btnVerConfirmar"
                    app:layout_constraintBottom_toBottomOf="parent"/>

                <ImageButton
                    android:id="@+id/btnVerConfirmar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_ojo_cerrado"
                    android:padding="12dp"
                    android:contentDescription="@string/reg_mostrar_confirmar"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- TERMINOS Y CONDICIONES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <androidx.appcompat.widget.AppCompatCheckBox
                    android:id="@+id/chkTerminos"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:button="@drawable/selector_terminos"
                    android:buttonTint="@null"
                    app:buttonTint="@null"
                    android:checked="false"
                    android:gravity="center_vertical"
                    android:contentDescription="@string/reg_aceptar_terminos"/>

                <TextView
                    android:id="@+id/txtTerminos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/reg_terminos"
                    android:textColor="#422018"
                    android:textSize="13sp"/>

            </LinearLayout>

            <!-- BOTON CREAR CUENTA -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCrearCuenta"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_boton"
                android:backgroundTint="#422018"
                app:backgroundTint="#422018"
                android:text="@string/reg_crear_cuenta"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:elevation="0dp"/>

            <!-- SEPARADOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8CBAE"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="@string/separador"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E8CBAE"/>

            </LinearLayout>

            <!-- REGISTRO CON GOOGLE -->
            <FrameLayout
                android:id="@+id/btnRegistroGoogle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_social"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/reg_google">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="20dp"
                    android:text="@string/letra_google"
                    android:textColor="#422018"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/reg_google"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

            </FrameLayout>

            <!-- REGISTRO CON APPLE -->
            <FrameLayout
                android:id="@+id/btnRegistroApple"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_social"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/reg_apple">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="22dp"
                    android:src="@drawable/ic_apple"
                    android:contentDescription="@null"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/reg_apple"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

            </FrameLayout>

            <!-- YA TIENES CUENTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reg_ya_tienes"
                    android:textColor="#422018"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/txtIrLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:layout_marginStart="8dp"
                    android:gravity="center"
                    android:text="@string/reg_inicia_sesion"
                    android:textColor="#422018"
                    android:textSize="14sp"
                    android:textStyle="bold"

                    android:clickable="true"
                    android:focusable="true"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
