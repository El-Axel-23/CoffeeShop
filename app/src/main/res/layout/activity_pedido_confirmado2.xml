<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF6EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- CIRCULO DE CONFIRMACION -->

        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="144dp"
            android:background="@drawable/bg_success_circle">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                app:tint="#FFFFFF"
                android:contentDescription="Pedido confirmado"/>

        </FrameLayout>

        <!-- TITULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="¡Pedido confirmado!"
            android:textColor="#3B1F14"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <!-- MENSAJE -->

        <TextView
            android:id="@+id/tvMensajeConfirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:gravity="center"
            android:text="Tu pedido va en camino. Ten listo el efectivo al recibirlo."
            android:textColor="#3B1F14"
            android:textSize="16sp"
            android:lineSpacingExtra="5dp"/>

        <!-- RESUMEN DEL PEDIDO -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            app:cardBackgroundColor="#F7E9DA"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tvProducto1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 Cappuccino Clásico"
                    android:textColor="#3B1F14"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/tvProducto2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:text="1 Croissant Mantequilla"
                    android:textColor="#3B1F14"
                    android:textSize="17sp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="28dp"
                    android:background="#EBD8C3"/>

                <TextView
                    android:id="@+id/tvTotalConfirmado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Total: $103"
                    android:textColor="#3B1F14"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- VOLVER AL INICIO -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverInicio"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="36dp"
            android:text="VOLVER AL INICIO"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#3B1F14"
            app:cornerRadius="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>