<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp"
    android:layout_marginBottom="8dp" android:background="#F4F0EB">
    <TextView android:id="@+id/txtNombre" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" android:textSize="18sp"/>
    <TextView android:id="@+id/txtDescripcion" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp"/>
    <TextView android:id="@+id/txtPrecio" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textStyle="bold" android:paddingTop="5dp"/>
    <Button android:id="@+id/btnAgregar" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Agregar / Ver"/>
</LinearLayout>