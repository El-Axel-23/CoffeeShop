<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#F5E5D5"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <!-- CONTENEDOR INTERNO -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- IMAGEN DEL CAFÉ -->
        <ImageView
            android:id="@+id/ivProducto"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:contentDescription="Imagen del producto"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/backgrounds/scenic" />

        <!-- ICONO DE FAVORITO (Corazón) -->
        <ImageView
            android:id="@+id/ivFavorito"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="6dp"
            android:background="@drawable/bg_circle_avatar"
            android:contentDescription="Marcar favorito"
            android:padding="6dp"
            android:src="@drawable/ic_favorite"
            app:layout_constraintEnd_toEndOf="@id/ivProducto"
            app:layout_constraintTop_toTopOf="@id/ivProducto"
            app:tint="#381C14" />

        <!-- NOMBRE DEL PRODUCTO -->
        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Latte Vainilla Avena"
            android:textColor="#2C1A10"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivProducto" />

        <!-- DESCRIPCIÓN CORTA -->
        <TextView
            android:id="@+id/tvDescripcionProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Nuestro café con leche de avena..."
            android:textColor="#6E584B"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvNombreProducto" />

        <!-- PRECIO -->
        <TextView
            android:id="@+id/tvPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="$65"
            android:textColor="#2C1A10"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDescripcionProducto" />

        <!-- BOTÓN PLUS (+) -->
        <FrameLayout
            android:id="@+id/btnAgregar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_black"
            android:backgroundTint="#381C14"
            app:layout_constraintBottom_toBottomOf="@id/tvPrecio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvPrecio">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="Agregar producto"
                android:src="@drawable/ic_plus"
                app:tint="#FFFDF9" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>